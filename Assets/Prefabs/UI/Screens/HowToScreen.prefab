      m_Calls: []
  m_text: 'Climb each haunted tower to the lantern above. Every room has a fork: take the ledges of the waking world, or enter a doorway.


    <color=#41e0d0>TEAL doors</color> open the Spirit world: new ledges appear, but your shadow follows your path 4 seconds behind. Any door is refuge.


    <color=#c07dff>VIOLET doors</color> flip gravity upward: walk off a ledge and rise to the next. Rise to HOME above.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7f135bff4d565e8438fd1c6901985ce6, type: 2}
  m_sharedMaterial: {fileID: -7316801695354276329, guid: 7f135bff4d565e8438fd1c6901985ce6, type: 2}
